#!/usr/bin/env bash

# sbf: Second Brain Formatter - Appends tags as wikilinks

# ===========================================
# Helper Functions
# ===========================================

# Simple logging function for info messages
log_info() {
    echo "[INFO] sbf: $1"
}

# Simple logging function for error messages and exit
log_error() {
    echo "[ERROR] sbf: $1" >&2

    exit 1
}

# ===========================================
# Main Script Logic
# ===========================================

main() {
    # Validate arguments
    if [[ $# -eq 0 ]]; then
        log_error "Usage: $0 <file_path>"
    fi

    local file="$1"

    # Validate the file: exists, is readable, and is writable (for appending and correcting)

    if [[ ! -f "$file" ]]; then
        log_error "File not found: '$file'"
    fi
    if [[ ! -r "$file" ]]; then
         log_error "File not readable: '$file'"
    fi
     if [[ ! -w "$file" ]]; then
          log_error "File not writable: '$file'"
    fi

    # realpath resolves symbolic links and gives the absolute path
    local target_file=$(realpath "$file")

    log_info "Processing file: '$target_file'"

    # ===========================================
    # Typo Correction: 'tags:' to 'Tags:'
    # ===========================================
    log_info "Checking for and correcting 'tags:' typo..."

    if grep -q '^tags[[:space:]]*:' "$target_file"; then
        log_info "Found 'tags:' typo. Attempting to correct to 'Tags:'."
        sed -i 's/^tags[[:space:]]*:/Tags:/' "$target_file"

        if [ $? -eq 0 ]; then
            log_info "'tags:' typo corrected successfully to 'Tags:'."
        else
            log_error "Failed to correct 'tags:' typo using sed."
            exit 1
        fi
    else
        log_info "No 'tags:' typo found. File seems correctly formatted for the tag marker."
    fi


    # ===========================================
    # Tag Extraction and Appending
    # ===========================================
    log_info "Extracting tags for appending wikilinks."
    local tags_to_append

    tags_to_append=$(awk '
        BEGIN {
            in_yaml = 0
            in_yaml_tags = 0
        }
        /^---$/ {
            if (in_yaml) {
                in_yaml = 0
                in_yaml_tags = 0
            } else {
                in_yaml = 1
            }
            next
        }
        in_yaml && /^Tags[[:space:]]*:/ {
            in_yaml_tags = 1
            next
        }
        in_yaml && in_yaml_tags && /[[:space:]]*-[[:space:]]/ {
            tag = $0
            gsub(/^[[:space:]]*-[[:space:]]*|[[:space:]]*$/, "", tag)
            if (tag != "") {
                print tag
            }
            next
        }
        !in_yaml && /#[A-Za-z0-9_-]+/ {
            split($0, line_tags, " ")
            for (t in line_tags) {
                tag = line_tags[t]
                if (tag ~ /^#/) {
                    gsub(/^#/, "", tag)
                    print tag
                }
            }
        }
    ' "$target_file" | sort -u)

    # ===========================================
    # Fallback: no tag found, apply default Zettelkasten tag
    # ===========================================
    if [[ -z "$tags_to_append" ]]; then
        log_info "No tag found. Applying default tag: Zettelkasten."


        # YAML requires spaces, not tabs — Obsidian rejects tab-indented front matter
        sed -i '/^Tags[[:space:]]*:/{
            /- Zettelkasten/! {
                a\    - Zettelkasten

            }
        }' "$target_file"

        log_info "Tag 'Zettelkasten' added to YAML front matter."

        # Only append the wikilink if it is not already present under ## Links
        if awk '/^## Links/{found=1} found && /\[\[Zettelkasten\]\]/{exit 1}' "$target_file"; then
            echo "" >> "$target_file"
            echo "[[Zettelkasten]]" >> "$target_file"
            log_info "Wikilink [[Zettelkasten]] added to the end of the note."
        else

            log_info "Wikilink [[Zettelkasten]] already present under ## Links, skipping."
        fi

    else
        # ===========================================
        # Normal case: tags were found
        # ===========================================
        log_info "Found unique tags to append as wikilinks."


        while IFS= read -r tag; do
            # Skip if the wikilink already exists under ## Links
            if awk '/^## Links/{found=1} found && /\[\['"$tag"'\]\]/{exit 1}' "$target_file"; then
                echo "" >> "$target_file"
                echo "[[$tag]]" >> "$target_file"
                log_info "Appended wikilink: [[$tag]]"
            else
                log_info "Wikilink [[$tag]] already present under ## Links, skipping."

            fi
        done <<< "$tags_to_append"
    fi

    log_info "Processing complete for '$target_file'."
}

# Run the main function with all script arguments
main "$@"
