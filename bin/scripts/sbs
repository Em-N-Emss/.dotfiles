#!/usr/bin/env bash

# sbs: Second Brain Sorter - Sorts notes into the correct directories

# ===========================================
# Configuration
# ===========================================
BASE_DIR="$HOME/Second-Brain"
DEFAULT_DIR="$BASE_DIR/Zettelkasten"
IMAGE_DIR="$BASE_DIR/Resources/Images/Zettelkasten"
INBOX_DIR="$BASE_DIR/Inbox"
ARCHIVE_DIR="$BASE_DIR/Archive"

# ===========================================
# Helper Functions
# ===========================================
log_info() {

    echo "[INFO] $1"
}

log_error() {
    echo "[ERROR] $1" >&2
}

validate_file() {
    local file="$1"
    if [[ ! -f "$file" ]]; then
        log_error "File does not exist: $file"
        exit 1
    fi
    if [[ ! -r "$file" ]]; then
        log_error "File is not readable: $file"
        exit 1
    fi

}


get_absolute_path() {
    local file="$1"

    if [[ ! "$file" = /* ]]; then
        echo "$PWD/$file"
    else
        echo "$file"
    fi
}

# Search for a directory matching the given term inside Second-Brain/
# Strategies: exact match → case-insensitive match → partial match

find_target_directory() {
    local search_term="$1"
    local target_path=""

    # Strategy 1: exact match
    target_path=$(find "$BASE_DIR" -path "$ARCHIVE_DIR" -prune -o -type d -name "$search_term" -print -quit)
    if [[ -n "$target_path" ]]; then
        echo "$target_path"
        return 0
    fi

    # Strategy 2: case-insensitive match
    target_path=$(find "$BASE_DIR" -path "$ARCHIVE_DIR" -prune -o -type d -iname "$search_term" -print -quit)
    if [[ -n "$target_path" ]]; then
        echo "$target_path"
        return 0
    fi

    # Strategy 3: partial match (contains)
    target_path=$(find "$BASE_DIR" -path "$ARCHIVE_DIR" -prune -o -type d -path "*$search_term*" -print -quit)
    if [[ -n "$target_path" ]]; then
        echo "$target_path"

        return 0
    fi

    return 1

}


process_image() {
    local file="$1"
    local filename="$2"

    if [[ "$filename" =~ ^Pasted[[:space:]]image[[:space:]][0-9]+\.png$ ]]; then
        log_info "Processing image: $filename"
        if mv "$file" "$IMAGE_DIR/"; then
            log_info "Successfully moved $filename to $IMAGE_DIR"
            return 0
        else
            log_error "Failed to move image file"
            return 1
        fi
    fi

    return 2

}


process_markdown() {

    local file="$1"

    log_info "Analyzing markdown content structure..."

    # ===========================================
    # Extract YAML tags (in order of appearance)

    # ===========================================
    # Do NOT sort: we want to preserve the declaration order from the file.
    # Each tag receives a position index (1, 2, 3...) used as priority.
    local yaml_tags
    yaml_tags=$(awk '
        BEGIN { in_yaml = 0; in_yaml_tags = 0; idx = 0 }
        /^---$/ {
            if (in_yaml) { in_yaml = 0; in_yaml_tags = 0 }
            else { in_yaml = 1 }
            next

        }
        in_yaml && /^Tags[[:space:]]*:/ { in_yaml_tags = 1; next }
        in_yaml && in_yaml_tags && /[[:space:]]*-[[:space:]]/ {
            tag = $0
            gsub(/^[[:space:]]*-[[:space:]]*|[[:space:]]*$/, "", tag)

            if (tag != "") {

                idx++
                printf "%s\t%d\tYAML\n", tag, idx
            }
            next
        }
        # Exit the tags section when another YAML key is encountered
        in_yaml && in_yaml_tags && /^[A-Za-z]/ { in_yaml_tags = 0 }
    ' "$file")


    # ===========================================
    # Extract wikilinks outside YAML (in order of appearance)
    # ===========================================

    local wikilinks
    wikilinks=$(awk '
        BEGIN { in_yaml = 0; idx = 0 }
        /^---$/ {
            if (in_yaml) { in_yaml = 0 }
            else { in_yaml = 1 }
            next
        }
        !in_yaml && /\[\[([^\]]+)\]\]/ {
            line = $0
            # Extract all wikilinks from the line in order
            while (match(line, /\[\[([^\]]+)\]\]/, arr)) {
                idx++
                printf "%s\t%d\tLINK\n", arr[1], idx

                # Advance past the matched wikilink

                line = substr(line, RSTART + RLENGTH)
            }
        }
    ' "$file")


    # ===========================================
    # Priority: YAML tags first (in order), then wikilinks (in order)
    # ===========================================

    # YAML tags are evaluated first by position index.
    # Wikilinks are only evaluated if no tag matched a directory.

    local target_path=""

    # --- Pass 1: YAML tags in order of appearance ---
    if [[ -n "$yaml_tags" ]]; then
        while IFS=$'\t' read -r identifier position type; do
            log_info "Trying YAML tag #$position: '$identifier'"
            # Short-circuit: Zettelkasten always resolves to DEFAULT_DIR directly,
            # bypassing find_target_directory which could match a deeper subfolder first.
            if [[ "$identifier" == "Zettelkasten" ]]; then
                target_path="$DEFAULT_DIR"
                log_info "Zettelkasten tag detected: resolved directly to $DEFAULT_DIR"
                break
            fi
            target_path=$(find_target_directory "$identifier")
            if [[ -n "$target_path" ]]; then
                log_info "Directory found via YAML tag: '$identifier' → $target_path"
                break
            else
                log_info "No directory for tag '$identifier', trying next."
            fi

        done < <(echo "$yaml_tags" | sort -t$'\t' -k2 -n)
        # sort -k2 -n: numeric sort on position column → guaranteed appearance order

    fi

    # --- Pass 2: Wikilinks in order of appearance (only if no tag matched) ---
    if [[ -z "$target_path" && -n "$wikilinks" ]]; then
        log_info "No YAML tag matched a directory. Falling back to wikilinks..."
        while IFS=$'\t' read -r identifier position type; do

            log_info "Trying wikilink #$position: '$identifier'"
            # Short-circuit: same Zettelkasten safeguard applied to wikilinks.
            if [[ "$identifier" == "Zettelkasten" ]]; then
                target_path="$DEFAULT_DIR"
                log_info "Zettelkasten wikilink detected: resolved directly to $DEFAULT_DIR"
                break
            fi
            target_path=$(find_target_directory "$identifier")
            if [[ -n "$target_path" ]]; then
                log_info "Directory found via wikilink: '$identifier' → $target_path"
                break
            else
                log_info "No directory for wikilink '$identifier', trying next."
            fi
        done < <(echo "$wikilinks" | sort -t$'\t' -k2 -n)
    fi

    # --- Fallback: default Zettelkasten directory ---
    if [[ -z "$target_path" ]]; then
        log_info "No tag or wikilink matched a directory. Using default directory."

        target_path="$DEFAULT_DIR"
    fi


    # Move the file
    if mv "$file" "$target_path/"; then
        log_info "Successfully moved file to: $target_path"
        return 0
    else
        log_error "Failed to move file to: $target_path"

        return 1
    fi
}

# ===========================================
# Main Script
# ===========================================
main() {
    if [[ $# -eq 0 ]]; then
        log_error "Usage: $0 <file_path>"
        exit 1
    fi

    local file

    file=$(get_absolute_path "$*")
    log_info "Processing file: $file"

    validate_file "$file"


    local filename
    filename=$(basename "$file")

    if process_image "$file" "$filename"; then
        exit 0
    elif [[ "$filename" =~ \.md$ ]]; then
        process_markdown "$file"
        exit $?
    else
        log_error "Unsupported file type: $filename"
        exit 1
    fi
}

main "$@"
